{
  "id": "shared-app-server-socket",
  "title": "Shared App-Server Socket",
  "description": "Opt-in protocol-transparent Unix socket shared by Codex Desktop and one or more ordinary app-server clients.",
  "defaultEnabled": false,
  "capabilities": [
    "external-app-server-attachment-descriptor-v1"
  ],
  "entrypoints": {
    "patchDescriptors": "./patch.js"
  },
  "resources": [
    {
      "source": "descriptor-reader.js",
      "target": ".codex-linux/features/shared-app-server-socket/descriptor-reader.js",
      "mode": "0644"
    }
  ],
  "runtimeHooks": {
    "launcher": {
      "source": "socket-env.sh",
      "name": "socket-env.sh",
      "mode": "0755"
    }
  }
}
